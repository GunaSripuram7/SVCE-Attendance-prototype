<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp"
    android:paddingTop="?attr/actionBarSize"
    android:fitsSystemWindows="true">

    <!-- BLE Code Entry Container -->


    <!-- Role Display -->
    <TextView
        android:id="@+id/tvAttendanceRole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Attendance as: "
        android:textSize="18sp"
        android:layout_marginTop="16dp" />

    <!-- Start/Stop Attendance -->
    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Attendance"
        android:enabled="false"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stop Attendance"
        android:enabled="false"
        android:layout_marginTop="8dp" />

    <!-- Status / Broadcast Countdown -->
    <TextView
        android:id="@+id/tvBroadcastCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Not broadcasting"
        android:layout_marginTop="16dp" />

    <!-- Real-time Scanning List (for teacher) -->
    <TextView
        android:id="@+id/tvScanningLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Live Scanning:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listRolls"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvRollCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Students: 0 total, 0 valid"
        android:textSize="14sp"
        android:layout_marginTop="4dp" />

    <!-- Final List Section -->
    <TextView
        android:id="@+id/tvFinalLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Final Attendance:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listFinalRolls"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvFinalCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Final count: 0 students"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnPingStudents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📱 Ping All Students"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        android:backgroundTint="@color/design_default_color_primary" />


</LinearLayout>
